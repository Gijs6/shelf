{% extends "base.jinja" %}

{% from "partials/entries.jinja" import entry_table %}

{% block title %}Sticky notes trash{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Sticky notes trash</h1>
    </div>

    {% if notes %}
        {% call(note) entry_table(notes, date_label="Deleted", date_attr="deleted_at", links=False) %}
            <form hx-patch="{{ url_for('sticky_notes.restore_sticky_note', sticky_note_id=note.id) }}"
                  hx-target="body"
                  hx-push-url="true">
                <button type="submit" class="btn btn--sm">Restore</button>
            </form>
            <form hx-delete="{{ url_for('sticky_notes.purge_sticky_note', sticky_note_id=note.id) }}"
                  hx-target="body"
                  hx-push-url="true"
                  hx-confirm="Delete {{ note.display_title | markdown_plain }}? This can't be undone.">
                <button type="submit" class="btn btn--danger btn--sm">Delete</button>
            </form>
        {% endcall %}
    {% else %}
        <div class="empty">
            <p class="empty__title">Trash is empty</p>
        </div>
    {% endif %}
{% endblock %}
