{% extends "base.jinja" %}

{% from "partials/sticky_card.jinja" import sticky_card %}

{% block title %}Sticky notes{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Sticky notes</h1>
        <div class="page-head__actions">
            <form hx-post="{{ url_for('sticky_notes.new_sticky_note') }}"
                  hx-target="body"
                  hx-push-url="true">
                <button type="submit" class="btn" data-shortcut="new">New sticky note</button>
            </form>
        </div>
    </div>

    {% if pinned_notes %}
        <section class="panel">
            <h2 class="panel__heading">
                <span>Pinned <span class="count">{{ "{:,}".format(pinned_notes | length) }}</span></span>
            </h2>
            <ul class="sticky-board">
                {% for sticky_note in pinned_notes %}{{ sticky_card(sticky_note, auto_open=(sticky_note.id == open_id)) }}{% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if active_notes %}
        <section class="panel">
            <h2 class="panel__heading">
                <span>{{ "Other" if pinned_notes else "All" }} <span class="count">{{ "{:,}".format(active_notes | length) }}</span></span>
            </h2>
            <ul class="sticky-board">
                {% for sticky_note in active_notes %}{{ sticky_card(sticky_note, auto_open=(sticky_note.id == open_id)) }}{% endfor %}
            </ul>
        </section>
    {% elif not pinned_notes %}
        <div class="empty">
            <p class="empty__title">No sticky notes yet</p>
        </div>
    {% endif %}
{% endblock %}
