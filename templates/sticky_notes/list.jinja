{% extends "base.jinja" %}

{% from "partials/sticky_card.jinja" import sticky_card %}

{% block title %}Sticky notes{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Sticky notes</h1>
        <div class="page-head__actions">
            <a href="{{ url_for('sticky_notes.trash') }}"
               class="btn"
               data-shortcut="trash">Trash</a>
            <form hx-post="{{ url_for('sticky_notes.new_sticky_note') }}"
                  hx-target="body"
                  hx-push-url="true">
                <button type="submit" class="btn" data-shortcut="new">New sticky note</button>
            </form>
        </div>
    </div>

    {% if pinned_notes %}
        <section class="panel">
            <h2 class="panel__heading">Pinned</h2>
            <ul class="sticky-board">
                {% for sticky_note in pinned_notes %}{{ sticky_card(sticky_note, heading_level=3, auto_open=(sticky_note.id == open_id)) }}{% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if active_notes %}
        <section class="panel">
            {% if pinned_notes %}<h2 class="panel__heading">Other</h2>{% endif %}
            <ul class="sticky-board">
                {% for sticky_note in active_notes %}{{ sticky_card(sticky_note, heading_level=3 if pinned_notes else 2, auto_open=(sticky_note.id == open_id)) }}{% endfor %}
            </ul>
        </section>
    {% elif not pinned_notes %}
        <div class="empty">
            <p class="empty__title">No sticky notes yet</p>
        </div>
    {% endif %}
{% endblock %}
