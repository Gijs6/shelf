{% extends "base.jinja" %}

{% from "partials/entries.jinja" import when, state_label %}
{% from "partials/updated_at.jinja" import updated_at_span %}

{% block title %}{{ todo.display_title | markdown_plain }}{% endblock %}

{% block content %}
    <article>
        <div class="page-head">
            <h1>{{ todo.display_title | markdown_inline }} ({{ state_label(todo) }})</h1>
        </div>

        <p class="entry-summary">
            Todo
            {%- if todo.group_name %} in group <a href="{{ url_for('search.search_view', q='is:todo group:' + todo.group_name) }}">{{ todo.group_name }}</a>{% endif %}
            {%- if todo.archived %}, archived{% endif %}.
            {% if todo.deadline %}Due {{ when(todo.deadline) }}.{% endif %}
            Made {{ when(todo.created_at) }}, edited {{ updated_at_span(todo) }}.
            {% if todo.state == "active" and todo.active_at %}Active since {{ when(todo.active_at) }}.{% endif %}
            {% if todo.completed_at %}Completed {{ when(todo.completed_at) }}.{% endif %}
        </p>

        <div class="form__actions entry-actions">
            <a href="{{ url_for('todos.edit_todo', todo_id=todo.id) }}"
               class="btn"
               data-shortcut="edit">Edit</a>
            <button type="button"
                    class="btn"
                    data-copy-html-target="todo-content"
                    data-copy-title="{{ todo.title or '' }}">Copy text</button>
            <form hx-post="{{ url_for('todos.duplicate_todo', todo_id=todo.id) }}"
                  hx-target="body"
                  hx-push-url="true">
                <button type="submit" class="btn">Duplicate</button>
            </form>
            {% if todo.archived %}
                <form hx-patch="{{ url_for('todos.unarchive_todo', todo_id=todo.id) }}"
                      hx-target="body"
                      hx-push-url="true"
                      data-shortcut="archive-toggle">
                    <button type="submit" class="btn">Unarchive</button>
                </form>
            {% else %}
                <form hx-patch="{{ url_for('todos.archive_todo', todo_id=todo.id) }}"
                      hx-target="body"
                      hx-push-url="true"
                      data-shortcut="archive-toggle">
                    <button type="submit" class="btn">Archive</button>
                </form>
            {% endif %}
            <form hx-delete="{{ url_for('todos.delete_todo', todo_id=todo.id) }}"
                  hx-target="body"
                  hx-push-url="true"
                  data-shortcut="delete">
                <button type="submit" class="btn btn--danger">Delete todo</button>
            </form>
        </div>

        <form hx-patch="{{ url_for('todos.set_state', todo_id=todo.id) }}"
              hx-target="body"
              hx-push-url="true">
            <fieldset class="btn-group state-picker">
                <legend class="visually-hidden">Change state</legend>
                {% for state in states %}
                    <button type="submit"
                            name="state"
                            value="{{ state }}"
                            data-state="{{ state }}"
                            aria-pressed="{{ 'true' if todo.state == state else 'false' }}"
                            class="btn btn--sm">{{ state | capitalize }}</button>
                {% endfor %}
            </fieldset>
        </form>

        <div id="todo-content" class="markdown">{{ todo.content | markdown(kind="todo", item_id=todo.id) }}</div>
    </article>
{% endblock %}
