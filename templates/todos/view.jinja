{% extends "base.jinja" %}

{% from "partials/entries.jinja" import when, title_state, group_prefix %}
{% from "partials/updated_at.jinja" import updated_at_span %}

{% block title %}{{ todo.display_title | markdown_plain }}{% endblock %}

{% block content %}
    <article>
        <div class="page-head">
            <div>
                <h1>{{ group_prefix(todo.group_name) }}{{ todo.display_title | markdown_inline }} {{ title_state(todo) }}</h1>
                <p class="page-head__sub">
                    Todo
                    {%- if todo.archived %}, archived{% endif %}
                </p>
            </div>
        </div>

        <div class="table-wrap">
            <table class="table table--kv table--fit">
                <caption class="visually-hidden">Details</caption>
                <tbody>
                    <tr>
                        {% if todo.deadline %}<th scope="row">Due</th><td>{{ when(todo.deadline) }}</td>{% endif %}
                        <th scope="row">Created</th>
                        <td>{{ when(todo.created_at) }}</td>
                        <th scope="row">Edited</th>
                        <td>{{ updated_at_span(todo) }}</td>
                        {% if todo.state == "active" and todo.active_at %}<th scope="row">Active since</th><td>{{ when(todo.active_at) }}</td>{% endif %}
                        {% if todo.completed_at %}<th scope="row">Completed</th><td>{{ when(todo.completed_at) }}</td>{% endif %}
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="page-actions">
            <form hx-patch="{{ url_for('todos.set_state', todo_id=todo.id) }}"
                  hx-target="body"
                  hx-push-url="true">
                <fieldset class="btn-group state-picker">
                    <legend class="visually-hidden">Change state</legend>
                    {% for state in states %}
                        <button type="submit"
                                name="state"
                                value="{{ state }}"
                                data-state="{{ state }}"
                                aria-pressed="{{ 'true' if todo.state == state else 'false' }}"
                                class="btn btn--sm">{{ state | capitalize }}</button>
                    {% endfor %}
                </fieldset>
            </form>
            <a href="{{ url_for('todos.edit_todo', todo_id=todo.id) }}"
               class="btn"
               data-shortcut="edit">Edit</a>
            <button type="button"
                    class="btn"
                    data-copy-html-target="todo-content"
                    data-copy-title="{{ todo.title or '' }}">Copy text</button>
            <form hx-post="{{ url_for('todos.duplicate_todo', todo_id=todo.id) }}"
                  hx-target="body"
                  hx-push-url="true">
                <button type="submit" class="btn">Duplicate</button>
            </form>
            {% if todo.archived %}
                <form hx-patch="{{ url_for('todos.unarchive_todo', todo_id=todo.id) }}"
                      hx-target="body"
                      hx-push-url="true"
                      data-shortcut="archive-toggle">
                    <button type="submit" class="btn">Unarchive</button>
                </form>
            {% else %}
                <form hx-patch="{{ url_for('todos.archive_todo', todo_id=todo.id) }}"
                      hx-target="body"
                      hx-push-url="true"
                      data-shortcut="archive-toggle">
                    <button type="submit" class="btn">Archive</button>
                </form>
            {% endif %}
            <form hx-delete="{{ url_for('todos.delete_todo', todo_id=todo.id) }}"
                  hx-target="body"
                  hx-push-url="true"
                  data-shortcut="delete">
                <button type="submit" class="btn btn--danger">Delete todo</button>
            </form>
        </div>

        <div id="todo-content" class="markdown">{{ todo.content | markdown(kind="todo", item_id=todo.id) }}</div>
    </article>
{% endblock %}
