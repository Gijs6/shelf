{% extends "base.jinja" %}

{% from "partials/date_chips.jinja" import date_chips %}

{% block title %}{{ "Edit todo" if todo and todo.id else "New todo" }}{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>
            {% if todo and todo.id %}
                Edit todo <code>{{ todo.id }}</code>
            {% else %}
                New todo
            {% endif %}
        </h1>
    </div>

    <form {% if todo and todo.id %} hx-put="{{ url_for('todos.update_todo', todo_id=todo.id) }}" {% else %} hx-post="{{ url_for('todos.create_todo') }}" {% endif %}
          hx-target="body"
          hx-push-url="true"
          class="editor"
          data-require-either="title,content">
        <div class="field field--wide">
            <label for="title" class="field__label">Title</label>
            <input type="text"
                   id="title"
                   name="title"
                   value="{{ todo.title or '' }}"
                   autofocus />
        </div>

        <div class="field field--wide">
            <label for="content" class="field__label">Content</label>
            <textarea id="content" name="content" class="editor__content">{{ todo.content if todo else '' }}</textarea>
        </div>

        <div class="field">
            <label for="group" class="field__label">Group</label>
            <input type="text"
                   id="group"
                   name="group"
                   data-autocomplete="todo-groups"
                   data-no-spaces
                   pattern="\S*"
                   title="Group names can't contain spaces"
                   autocomplete="off"
                   placeholder="Search or create a group"
                   value="{{ todo.group_name or '' }}" />
            <datalist id="todo-groups">
                {% for group in groups %}<option value="{{ group }}"></option>{% endfor %}
            </datalist>
        </div>

        <div class="field">
            <label for="deadline" class="field__label">Due at</label>
            <input type="datetime-local"
                   id="deadline"
                   name="deadline"
                   value="{{ todo.deadline | strftime('%Y-%m-%dT%H:%M') if todo and todo.deadline else '' }}" />
            {{ date_chips("deadline") }}
        </div>

        <div class="form__actions">
            <button type="submit" class="btn">Save todo</button>
        </div>
    </form>
{% endblock %}
