{% extends "base.jinja" %}

{% from "partials/entries.jinja" import entry_table %}

{% block title %}Todos{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Todos</h1>
        <div class="page-head__actions">
            <a href="{{ url_for('todos.archived') }}"
               class="btn"
               data-shortcut="archived">Archived</a>
            <a href="{{ url_for('todos.trash') }}" class="btn" data-shortcut="trash">Trash</a>
            <a href="{{ url_for('todos.new_todo') }}"
               class="btn"
               data-shortcut="new">New todo</a>
        </div>
    </div>

    <nav class="btn-group" aria-label="Filter todos by state">
        {% for state in states %}
            <a href="{{ chip_links[state] }}"
               class="btn btn--sm"
               {% if state in selected_states %}aria-current="true"{% endif %}>{{ state | capitalize }}</a>
        {% endfor %}
    </nav>

    {% if sections %}
        {% for label, items in sections %}
            <section class="panel">
                <h2 class="panel__heading">{{ label }}</h2>
                {{ entry_table(items, date_label="Created", date_attr="created_at", state=True, due=True) }}
            </section>
        {% endfor %}
    {% else %}
        <div class="empty">
            <p class="empty__title">No todos yet</p>
        </div>
    {% endif %}
{% endblock %}
