{% extends "base.jinja" %}

{% from "partials/entries.jinja" import entry_table %}

{% block title %}Todos trash{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Todos trash</h1>
    </div>

    {% if todos %}
        {% call(todo) entry_table(todos, date_label="Deleted", date_attr="deleted_at", state=True, due=True, links=False) %}
            <form hx-patch="{{ url_for('todos.restore_todo', todo_id=todo.id) }}"
                  hx-target="body"
                  hx-push-url="true">
                <button type="submit" class="btn btn--sm">Restore</button>
            </form>
            <form hx-delete="{{ url_for('todos.purge_todo', todo_id=todo.id) }}"
                  hx-target="body"
                  hx-push-url="true"
                  hx-confirm="Delete {{ todo.display_title | markdown_plain }}? This can't be undone.">
                <button type="submit" class="btn btn--danger btn--sm">Delete</button>
            </form>
        {% endcall %}
    {% else %}
        <div class="empty">
            <p class="empty__title">Trash is empty</p>
        </div>
    {% endif %}
{% endblock %}
