{% extends "base.jinja" %}

{% from "partials/entries.jinja" import entry_table %}

{% block title %}Archived todos{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Archived todos</h1>
    </div>

    {% if todos %}
        {% call(todo) entry_table(todos, date_label="Archived", date_attr="archived_at", state=True, due=True) %}
            <form hx-patch="{{ url_for('todos.unarchive_todo', todo_id=todo.id) }}"
                  hx-target="body"
                  hx-push-url="true">
                <button type="submit" class="btn btn--sm">Unarchive</button>
            </form>
        {% endcall %}
    {% else %}
        <div class="empty">
            <p class="empty__title">No archived todos</p>
        </div>
    {% endif %}
{% endblock %}
