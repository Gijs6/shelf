<!DOCTYPE html>
<html lang="en-GB" data-tz="{{ TIME_ZONE }}">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex, nofollow" />

        <title>{%- block title -%}{%- endblock %} - Shelf</title>
        <meta name="description" content="Notes, sticky notes and todos." />
        <meta name="theme-color"
              content="#864bca"
              media="(prefers-color-scheme: light)" />
        <meta name="theme-color"
              content="#7e46bd"
              media="(prefers-color-scheme: dark)" />

        <link rel="icon"
              href="{{ url_for('static', filename='favicon.svg') }}"
              type="image/svg+xml" />
        <link rel="alternate icon"
              href="{{ url_for('static', filename='favicon.ico') }}" />
        <link rel="manifest"
              href="{{ url_for('static', filename='manifest.json') }}" />

        <link rel="stylesheet"
              href="{{ url_for('static', filename='vendor/easymde.min.css') }}" />

        <meta name="htmx-config"
              content='{"historyCacheSize": 0, "responseHandling": [{"code": "204", "swap": false}, {"code": "[234]..", "swap": true}, {"code": "5..", "swap": false, "error": true}]}' />

        {% set theme = "https://cdn.gijs6.nl/theme/v2" %}
        <link rel="stylesheet" href="{{ theme }}/all.css" />
        <link rel="stylesheet" href="{{ theme }}/accent/purple.css" />
        <link rel="stylesheet" href="{{ theme }}/addons/easymde.css" />
        {% if config.DEBUG %}
            <link rel="stylesheet"
                  href="{{ url_for('static', filename='styles/app.css') }}" />
        {% else %}
            <link rel="stylesheet"
                  href="{{ url_for('static', filename='styles/app.min.css') }}" />
        {% endif %}

        <script src="{{ url_for('static', filename='vendor/htmx.min.js') }}" defer></script>
        <script src="{{ theme }}/js/toast.js" defer></script>
        <script src="{{ theme }}/js/confirm.js" defer></script>

        {% block extra_headers %}{% endblock %}
    </head>

    <body class="app {% block body_class %}{% endblock %}" hx-boost="true">
        {% include "partials/toaster.jinja" %}

        {% block body_content %}{% endblock %}

        {% include "_footer.jinja" %}

        <dialog id="shortcuts-modal" class="dialog" aria-labelledby="shortcuts-title">
            <div class="dialog__head">
                <h2 id="shortcuts-title">Keyboard shortcuts</h2>
                <form method="dialog">
                    <button type="submit" class="dialog__close" aria-label="Close">&times;</button>
                </form>
            </div>
            <div class="dialog__body">
                <h3>Global</h3>
                <table class="table table--kv">
                    <tbody>
                        <tr>
                            <th scope="row"><kbd>?</kbd></th>
                            <td>Show this help</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>Esc</kbd></th>
                            <td>Go back / close</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>Ctrl</kbd> <kbd>Enter</kbd></th>
                            <td>Submit the current form</td>
                        </tr>
                    </tbody>
                </table>
                <h3>Go to</h3>
                <table class="table table--kv">
                    <tbody>
                        <tr>
                            <th scope="row"><kbd>/</kbd></th>
                            <td>Search</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>g</kbd> <kbd>d</kbd></th>
                            <td>Dashboard</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>g</kbd> <kbd>n</kbd></th>
                            <td>Notes</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>g</kbd> <kbd>t</kbd></th>
                            <td>Todos</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>g</kbd> <kbd>s</kbd></th>
                            <td>Sticky notes</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>g</kbd> <kbd>b</kbd></th>
                            <td>Bookmarks</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>a</kbd></th>
                            <td>Archive</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>t</kbd></th>
                            <td>Trash</td>
                        </tr>
                    </tbody>
                </table>
                <h3>Create</h3>
                <table class="table table--kv">
                    <tbody>
                        <tr>
                            <th scope="row"><kbd>c</kbd> <kbd>n</kbd></th>
                            <td>New note</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>c</kbd> <kbd>t</kbd></th>
                            <td>New todo</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>c</kbd> <kbd>s</kbd></th>
                            <td>New sticky note</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>c</kbd> <kbd>b</kbd></th>
                            <td>New bookmark</td>
                        </tr>
                    </tbody>
                </table>
                <h3>On a notes/todos/sticky notes/bookmarks list</h3>
                <table class="table table--kv">
                    <tbody>
                        <tr>
                            <th scope="row"><kbd>n</kbd></th>
                            <td>New</td>
                        </tr>
                    </tbody>
                </table>
                <h3>On a note, todo or bookmark</h3>
                <table class="table table--kv">
                    <tbody>
                        <tr>
                            <th scope="row"><kbd>e</kbd></th>
                            <td>Edit</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>a</kbd></th>
                            <td>Toggle archive</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>d</kbd></th>
                            <td>Delete</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> <kbd>4</kbd> <kbd>5</kbd></th>
                            <td>Set state to shelved / open / active / done / cancelled</td>
                        </tr>
                    </tbody>
                </table>
                <h3>On a focused sticky note</h3>
                <table class="table table--kv">
                    <tbody>
                        <tr>
                            <th scope="row"><kbd>p</kbd></th>
                            <td>Toggle pin</td>
                        </tr>
                        <tr>
                            <th scope="row"><kbd>d</kbd></th>
                            <td>Delete</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </dialog>

        <script type="application/json" id="nav-routes">
            {
                "dashboard": "{{ url_for('index') }}",
                "notes": "{{ url_for('notes.list_notes') }}",
                "todos": "{{ url_for('todos.list_todos') }}",
                "stickyNotes": "{{ url_for('sticky_notes.list_sticky_notes') }}",
                "newNote": "{{ url_for('notes.new_note') }}",
                "newTodo": "{{ url_for('todos.new_todo') }}",
                "newStickyNote": "{{ url_for('sticky_notes.new_sticky_note') }}",
                "bookmarks": "{{ url_for('bookmarks.list_bookmarks') }}",
                "newBookmark": "{{ url_for('bookmarks.new_bookmark') }}",
                "search": "{{ url_for('search.search_view') }}"
            }
        </script>

        <script src="{{ url_for('static', filename='vendor/easymde.min.js') }}"></script>

        <script src="{{ url_for('static', filename='scripts/markdown-editor.js') }}"></script>
        <script src="{{ url_for('static', filename='scripts/live-timestamps.js') }}"></script>
        <script src="{{ url_for('static', filename='scripts/required-fields.js') }}"></script>
        <script src="{{ url_for('static', filename='scripts/shortcuts-modal.js') }}"></script>
        <script src="{{ url_for('static', filename='scripts/keyboard-shortcuts.js') }}"></script>
        <script src="{{ url_for('static', filename='scripts/copy-button.js') }}"></script>
        <script src="{{ url_for('static', filename='scripts/sticky-inline-edit.js') }}"></script>
        <script src="{{ url_for('static', filename='scripts/search-help-modal.js') }}"></script>
        <script src="{{ url_for('static', filename='scripts/rename-group-modal.js') }}"></script>
        <script src="{{ url_for('static', filename='scripts/group-autocomplete.js') }}"></script>
        <script src="{{ url_for('static', filename='scripts/no-spaces.js') }}"></script>
        <script src="{{ url_for('static', filename='scripts/date-chips.js') }}"></script>
    </body>
</html>
