{% extends "base.jinja" %}

{% from "partials/entries.jinja" import entry_table %}
{% from "partials/sticky_card.jinja" import sticky_card %}

{% block title %}Dashboard{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Dashboard</h1>
    </div>

    <section class="panel">
        <h2 class="panel__heading">Upcoming and overdue todos</h2>
        {% if upcoming_todos %}
            {{ entry_table(upcoming_todos, state=True, due=True, date_attr=None) }}
        {% else %}
            <div class="empty">
                <p class="empty__title">Nothing due</p>
            </div>
        {% endif %}
    </section>

    <section class="panel">
        <h2 class="panel__heading">Recent notes</h2>
        {% if recent_notes %}
            {{ entry_table(recent_notes) }}
        {% else %}
            <div class="empty">
                <p class="empty__title">No notes yet</p>
            </div>
        {% endif %}
    </section>

    <section class="panel">
        <h2 class="panel__heading">Pinned and active sticky notes</h2>
        {% if sticky_notes %}
            <ul class="sticky-board">
                {% for sticky_note in sticky_notes %}{{ sticky_card(sticky_note, compact=True) }}{% endfor %}
            </ul>
        {% else %}
            <div class="empty">
                <p class="empty__title">No sticky notes yet</p>
            </div>
        {% endif %}
    </section>
{% endblock %}
