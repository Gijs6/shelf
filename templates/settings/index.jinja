{% extends "base.jinja" %}

{% from "partials/entries.jinja" import when %}

{% block title %}Settings{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Settings</h1>
    </div>

    <section class="panel">
        <h2 class="panel__heading">Export all data</h2>
        <div class="panel__body">
            <a href="{{ url_for('settings.export') }}" class="btn">Export JSON</a>
        </div>
    </section>

    <section class="panel">
        <h2 class="panel__heading">Import data</h2>
        <form method="post"
              action="{{ url_for('settings.import_data') }}"
              enctype="multipart/form-data"
              class="panel__body">
            <div class="field">
                <label for="file" class="field__label">JSON file</label>
                <input type="file"
                       id="file"
                       name="file"
                       accept="application/json,.json"
                       required />
            </div>
            <div class="form__actions">
                <button type="submit" class="btn">Import data</button>
            </div>
        </form>
    </section>

    <section class="panel">
        <h2 class="panel__heading">Trash</h2>
        {% if total_trash %}
            <div class="panel__body">
                <p>
                    {{ trash_counts.notes }} {{ trash_counts.notes | pluralize("note") }},
                    {{ trash_counts.sticky_notes }} sticky {{ trash_counts.sticky_notes | pluralize("note") }}
                    and {{ trash_counts.todos }} {{ trash_counts.todos | pluralize("todo") }} in trash.
                </p>
                <form hx-delete="{{ url_for('settings.purge_all_trash') }}"
                      hx-target="body"
                      hx-push-url="true"
                      hx-confirm="Delete everything in trash across notes, todos and sticky notes? This can't be undone.">
                    <button type="submit" class="btn btn--danger">Empty trash</button>
                </form>
            </div>
        {% else %}
            <div class="empty">
                <p class="empty__title">Trash is empty</p>
            </div>
        {% endif %}
    </section>

    <section class="panel">
        <h2 class="panel__heading">Expired sticky notes</h2>
        {% if expired_sticky_note_count %}
            <div class="panel__body">
                <p>
                    {{ expired_sticky_note_count }} expired sticky
                    {{ expired_sticky_note_count | pluralize("note") }} not yet in trash.
                </p>
                <form hx-delete="{{ url_for('settings.clear_expired_sticky_notes') }}"
                      hx-target="body"
                      hx-push-url="true"
                      hx-confirm="Move all expired sticky notes to trash?">
                    <button type="submit" class="btn">Move expired to trash</button>
                </form>
            </div>
        {% else %}
            <div class="empty">
                <p class="empty__title">No expired sticky notes</p>
            </div>
        {% endif %}
    </section>

    <section class="panel">
        <h2 class="panel__heading">Groups</h2>
        {% if group_counts %}
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Group</th>
                            <th class="table__num">Notes</th>
                            <th class="table__num">Todos</th>
                            <th class="table__actions">
                                <span class="visually-hidden">Actions</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for name, counts in group_counts.items() %}
                            <tr>
                                <td>{{ name }}</td>
                                <td class="table__num">{{ "{:,}".format(counts.notes) }}</td>
                                <td class="table__num">{{ "{:,}".format(counts.todos) }}</td>
                                <td class="table__actions">
                                    <button type="button"
                                            class="btn btn--sm"
                                            data-rename-group="{{ name }}"
                                            aria-haspopup="dialog">Rename</button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="empty">
                <p class="empty__title">No groups yet</p>
            </div>
        {% endif %}
    </section>

    <section class="panel">
        <h2 class="panel__heading">Delete all data</h2>
        <div class="panel__body">
            <form hx-delete="{{ url_for('settings.remove_all') }}"
                  hx-target="body"
                  hx-push-url="true"
                  hx-confirm="Delete all notes, todos and sticky notes? This can't be undone.">
                <button type="submit" class="btn btn--danger">Delete all data</button>
            </form>
        </div>
    </section>

    <section class="panel">
        <h2 class="panel__heading">Calendar feed</h2>
        <div class="panel__body">
            {% if calendar_url %}
                <p>Subscribe to this URL from your calendar app to see todo deadlines.</p>
                <div class="input-row">
                    <label for="calendar-url" class="visually-hidden">Feed URL</label>
                    <input type="text" id="calendar-url" value="{{ calendar_url }}" readonly />
                    <button type="button"
                            class="btn"
                            data-copy-target="calendar-url"
                            data-copied="Link copied.">Copy link</button>
                </div>
                <div class="form__actions">
                    <form hx-post="{{ url_for('settings.generate_calendar_token') }}"
                          hx-target="body"
                          hx-push-url="true"
                          hx-confirm="Regenerate the token? The old feed URL stops working.">
                        <button type="submit" class="btn">Regenerate token</button>
                    </form>
                    <form hx-delete="{{ url_for('settings.revoke_calendar_token') }}"
                          hx-target="body"
                          hx-push-url="true">
                        <button type="submit" class="btn btn--danger">Revoke token</button>
                    </form>
                </div>
            {% else %}
                <p>A token gives you a private URL you can subscribe to from a calendar app.</p>
                <form hx-post="{{ url_for('settings.generate_calendar_token') }}"
                      hx-target="body"
                      hx-push-url="true">
                    <button type="submit" class="btn">Generate token</button>
                </form>
            {% endif %}
        </div>
    </section>

    {% if last_login %}
        <section class="panel">
            <h2 class="panel__heading">Session</h2>
            <div class="panel__body">
                <p>
                    Signed in since {{ when(last_login) }}.
                    Session expires {{ when(session_expires_at) }}.
                </p>
            </div>
        </section>
    {% endif %}


    <dialog id="rename-group-modal" class="dialog" aria-labelledby="rename-group-title">
        <div class="dialog__head">
            <h2 id="rename-group-title">Rename group</h2>
            <form method="dialog">
                <button type="submit" class="dialog__close" aria-label="Close">&times;</button>
            </form>
        </div>
        <form hx-post="{{ url_for('settings.rename_group') }}"
              hx-target="body"
              hx-push-url="true">
            <div class="dialog__body">
                <input type="hidden" name="old_name" value="" />
                <div class="field">
                    <label for="rename-group-name" class="field__label">New name</label>
                    <input type="text"
                           id="rename-group-name"
                           name="new_name"
                           data-no-spaces
                           pattern="\S*"
                           title="Group names can't contain spaces"
                           required />
                </div>
            </div>
            <div class="dialog__actions">
                <button type="submit" class="btn">Save name</button>
            </div>
        </form>
    </dialog>
{% endblock %}
