{% extends "skeleton.jinja" %}

{% macro nav_link(endpoint, label) %}
    <a href="{{ url_for(endpoint) }}"
       {% if request.endpoint == endpoint or (request.blueprint and request.blueprint == endpoint.split('.')[0]) %}aria-current="page"{% endif %}>{{ label }}</a>
{% endmacro %}

{% block body_content %}
    <header class="navbar">
        <div class="navbar__inner">
            <a href="{{ url_for('index') }}" class="navbar__brand">{% include "mark.svg" %}Shelf</a>
            <nav class="navbar__links" aria-label="Main navigation">
                {{ nav_link('index', 'Dashboard') }}
                {{ nav_link('notes.list_notes', 'Notes') }}
                {{ nav_link('todos.list_todos', 'Todos') }}
                {{ nav_link('sticky_notes.list_sticky_notes', 'Sticky notes') }}
                {{ nav_link('search.search_view', 'Search') }}
                {{ nav_link('settings.index', 'Settings') }}
            </nav>
        </div>
    </header>

    <main class="page">
        <noscript>
            <div class="alert alert--warning">
                <p>You're running Shelf without JavaScript. Enable JavaScript to use all features.</p>
            </div>
        </noscript>
        {% block content %}{% endblock %}
    </main>
{% endblock %}
