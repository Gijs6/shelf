{% extends "base.jinja" %}

{% from "partials/entries.jinja" import entry_table %}

{% block title %}Notes{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Notes</h1>
        <div class="page-head__actions">
            <a href="{{ url_for('notes.archived') }}"
               class="btn"
               data-shortcut="archived">Archived</a>
            <a href="{{ url_for('notes.trash') }}" class="btn" data-shortcut="trash">Trash</a>
            <a href="{{ url_for('notes.new_note') }}"
               class="btn"
               data-shortcut="new">New note</a>
        </div>
    </div>

    {% if sections %}
        {% for label, items in sections %}
            <section class="panel">
                <h2 class="panel__heading">{{ label }}</h2>
                {{ entry_table(items) }}
            </section>
        {% endfor %}
    {% else %}
        <div class="empty">
            <p class="empty__title">No notes yet</p>
        </div>
    {% endif %}
{% endblock %}
