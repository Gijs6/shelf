{% extends "base.jinja" %}

{% from "partials/entries.jinja" import entry_table %}

{% block title %}Archived notes{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Archived notes</h1>
    </div>

    {% if notes %}
        {% call(note) entry_table(notes, date_label="Archived", date_attr="archived_at") %}
            <form hx-patch="{{ url_for('notes.unarchive_note', note_id=note.id) }}"
                  hx-target="body"
                  hx-push-url="true">
                <button type="submit" class="btn btn--sm">Unarchive</button>
            </form>
        {% endcall %}
    {% else %}
        <div class="empty">
            <p class="empty__title">No archived notes</p>
        </div>
    {% endif %}
{% endblock %}
