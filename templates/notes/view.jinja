{% extends "base.jinja" %}

{% from "partials/entries.jinja" import when, group_prefix %}
{% from "partials/updated_at.jinja" import updated_at_span %}

{% block title %}{{ note.display_title | markdown_plain }}{% endblock %}

{% block content %}
    <article>
        <div class="page-head">
            <div>
                <h1>
                    {{ group_prefix(note.group_name) }}{{ note.display_title | markdown_inline }}
                    {%- if note.archived %} <span class="status">(archived)</span>{% endif %}
                </h1>
                <p class="page-head__sub">Note</p>
            </div>
        </div>

        <div class="table-wrap">
            <table class="table table--kv table--fit">
                <caption class="visually-hidden">Details</caption>
                <tbody>
                    <tr>
                        <th scope="row">Created</th>
                        <td>{{ when(note.created_at) }}</td>
                        <th scope="row">Edited</th>
                        <td>{{ updated_at_span(note) }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="page-actions">
            <a href="{{ url_for('notes.edit_note', note_id=note.id) }}"
               class="btn"
               data-shortcut="edit">Edit note</a>
            <button type="button"
                    class="btn"
                    data-copy-html-target="note-content"
                    data-copy-title="{{ note.title or '' }}">Copy text</button>
            <form hx-post="{{ url_for('notes.duplicate_note', note_id=note.id) }}"
                  hx-target="body"
                  hx-push-url="true">
                <button type="submit" class="btn">Duplicate note</button>
            </form>
            {% if note.archived %}
                <form hx-patch="{{ url_for('notes.unarchive_note', note_id=note.id) }}"
                      hx-target="body"
                      hx-push-url="true"
                      data-shortcut="archive-toggle">
                    <button type="submit" class="btn">Unarchive note</button>
                </form>
            {% else %}
                <form hx-patch="{{ url_for('notes.archive_note', note_id=note.id) }}"
                      hx-target="body"
                      hx-push-url="true"
                      data-shortcut="archive-toggle">
                    <button type="submit" class="btn">Archive note</button>
                </form>
            {% endif %}
            <form hx-delete="{{ url_for('notes.delete_note', note_id=note.id) }}"
                  hx-target="body"
                  hx-push-url="true"
                  data-shortcut="delete">
                <button type="submit" class="btn btn--danger">Delete note</button>
            </form>
        </div>

        <div id="note-content" class="markdown">{{ note.content | markdown(kind="note", item_id=note.id) }}</div>
    </article>
{% endblock %}
