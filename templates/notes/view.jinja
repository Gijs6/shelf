{% extends "base.jinja" %}

{% from "partials/entries.jinja" import when %}
{% from "partials/updated_at.jinja" import updated_at_span %}

{% block title %}{{ note.display_title | markdown_plain }}{% endblock %}

{% block content %}
    <article>
        <div class="page-head">
            <h1>{{ note.display_title | markdown_inline }}</h1>
        </div>

        <p class="entry-summary">
            Note
            {%- if note.group_name %} in group <a href="{{ url_for('search.search_view', q='is:note group:' + note.group_name) }}">{{ note.group_name }}</a>{% endif %}
            {%- if note.archived %}, archived{% endif %}.
            Made {{ when(note.created_at) }}, edited {{ updated_at_span(note) }}.
        </p>

        <div class="form__actions entry-actions">
            <a href="{{ url_for('notes.edit_note', note_id=note.id) }}"
               class="btn"
               data-shortcut="edit">Edit</a>
            <button type="button"
                    class="btn"
                    data-copy-html-target="note-content"
                    data-copy-title="{{ note.title or '' }}">Copy text</button>
            <form hx-post="{{ url_for('notes.duplicate_note', note_id=note.id) }}"
                  hx-target="body"
                  hx-push-url="true">
                <button type="submit" class="btn">Duplicate</button>
            </form>
            {% if note.archived %}
                <form hx-patch="{{ url_for('notes.unarchive_note', note_id=note.id) }}"
                      hx-target="body"
                      hx-push-url="true"
                      data-shortcut="archive-toggle">
                    <button type="submit" class="btn">Unarchive</button>
                </form>
            {% else %}
                <form hx-patch="{{ url_for('notes.archive_note', note_id=note.id) }}"
                      hx-target="body"
                      hx-push-url="true"
                      data-shortcut="archive-toggle">
                    <button type="submit" class="btn">Archive</button>
                </form>
            {% endif %}
            <form hx-delete="{{ url_for('notes.delete_note', note_id=note.id) }}"
                  hx-target="body"
                  hx-push-url="true"
                  data-shortcut="delete">
                <button type="submit" class="btn btn--danger">Delete note</button>
            </form>
        </div>

        <div id="note-content" class="markdown">{{ note.content | markdown(kind="note", item_id=note.id) }}</div>
    </article>
{% endblock %}
