{% extends "base.jinja" %}

{% block title %}{{ "Edit note" if note and note.id else "New note" }}{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>
            {% if note and note.id %}
                Edit note <code>{{ note.id }}</code>
            {% else %}
                New note
            {% endif %}
        </h1>
    </div>

    <form {% if note and note.id %} hx-put="{{ url_for('notes.update_note', note_id=note.id) }}" {% else %} hx-post="{{ url_for('notes.create_note') }}" {% endif %}
          hx-target="body"
          hx-push-url="true"
          class="editor"
          data-require-either="title,content">
        <div class="field field--wide">
            <label for="title" class="field__label">Title</label>
            <input type="text"
                   id="title"
                   name="title"
                   value="{{ note.title or '' }}"
                   autofocus />
        </div>

        <div class="field field--wide">
            <label for="content" class="field__label">Content</label>
            <textarea id="content" name="content" class="editor__content">{{ note.content if note else '' }}</textarea>
        </div>

        <div class="field">
            <label for="group" class="field__label">Group</label>
            <input type="text"
                   id="group"
                   name="group"
                   data-autocomplete="note-groups"
                   data-no-spaces
                   pattern="\S*"
                   title="Group names can't contain spaces"
                   autocomplete="off"
                   placeholder="Search or create a group"
                   value="{{ note.group_name or '' }}" />
            <datalist id="note-groups">
                {% for group in groups %}<option value="{{ group }}"></option>{% endfor %}
            </datalist>
        </div>

        <div class="form__actions">
            <button type="submit" class="btn">Save note</button>
        </div>
    </form>
{% endblock %}
