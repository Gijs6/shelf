{% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
        <div class="toaster" aria-live="polite">
            {% for category, message in messages %}
                {% set text = message.text if message is mapping else message %}
                <div class="toast toast--{{ toast_type(category) }}"
                     role="status"
                     data-auto-dismiss="6000">
                    <div class="toast__body">
                        {{ text }}
                        {% if message is mapping and message.undo_url %}
                            {# djlint:off #}
                            <form class="toast__undo"
                                  hx-{{ message.undo_method | lower }}="{{ message.undo_url }}"
                                  hx-target="body"
                                  hx-push-url="true">
                                <button type="submit" class="btn btn--sm">Undo</button>
                            </form>
                            {# djlint:on #}
                        {% endif %}
                    </div>
                    <button type="button" class="toast__dismiss" aria-label="Dismiss">&times;</button>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endwith %}
