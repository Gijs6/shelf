{% from "partials/icons.jinja" import icon %}

{% macro empty_state(icon_name, message, cta_href=none, cta_label=none, cta_method="get") %}
    <div class="empty-state">
        {{ icon(icon_name, class="empty-state__icon") }}
        <p class="empty-state__message">{{ message }}</p>
        {% if cta_href %}
            {% if cta_method == "post" %}
                <form hx-post="{{ cta_href }}" hx-target="body" hx-push-url="true">
                    <button type="submit" class="button">{{ icon("plus") }} {{ cta_label }}</button>
                </form>
            {% else %}
                <a href="{{ cta_href }}" class="button">{{ icon("plus") }} {{ cta_label }}</a>
            {% endif %}
        {% endif %}
    </div>
{% endmacro %}
