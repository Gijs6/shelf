{% macro updated_at_span(item, oob=False) %}
    <span id="detail-updated-at"{% if oob %} hx-swap-oob="true"{% endif %}>
        <time datetime="{{ item.updated_at | isoformat }}" data-live>{{ item.updated_at | timeago }}</time>
        (<time datetime="{{ item.updated_at | isoformat }}">{{ item.updated_at | strftime("%d %b %Y, %H:%M") }}</time>)
    </span>
{% endmacro %}
