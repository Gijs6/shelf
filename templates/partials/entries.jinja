{% macro when(dt) -%}
    <time datetime="{{ dt | isoformat }}">{{ dt | strftime }}</time> (<time datetime="{{ dt | isoformat }}" data-live>{{ dt | timeago }}</time>)
{%- endmacro %}

{% macro state_label(todo) -%}
    <span class="status {{ {'open': 'status--open', 'active': 'status--warn', 'done': 'status--ok'}.get(todo.state, '') }}">{{ todo.state | capitalize }}</span>
    {%- if todo.overdue %}, <span class="status status--bad">overdue</span>{% endif %}
{%- endmacro %}

{% macro title_state(todo) -%}
    <span class="status {{ {'open': 'status--open', 'active': 'status--warn', 'done': 'status--ok'}.get(todo.state, '') }}">({{ todo.state }}
        {%- if todo.overdue %}, <span class="status--bad">overdue</span>{% endif %})</span>
{%- endmacro %}

{% macro group_prefix(name) -%}
    {%- if name %}<span class="group-prefix"><a href="{{ url_for('search.search_view', q='group:' + name) }}">{{ name }}</a> /</span> {% endif -%}
{%- endmacro %}

{% macro favicon(item) -%}
    <img class="favicon" src="{{ url_for('bookmarks.favicon', bookmark_id=item.id, v=item.favicon_version) }}" alt="" width="16" height="16" loading="lazy" />
{%- endmacro %}

{% macro bookmark_link(item) -%}
    <a href="{{ item.url | e }}" target="_blank" rel="noopener noreferrer">{{ item.display_url | e }}</a>
{%- endmacro %}

{% macro entry_url(item) -%}
    {%- if item.endpoint -%}
        {{ url_for(item.endpoint, **item.url_kwargs) }}
    {%- elif item.kind == "note" -%}
        {{ url_for('notes.view_note', note_id=item.id) }}
    {%- elif item.kind == "todo" -%}
        {{ url_for('todos.view_todo', todo_id=item.id) }}
    {%- elif item.kind == "bookmark" -%}
        {{ url_for('bookmarks.view_bookmark', bookmark_id=item.id) }}
    {%- endif -%}
{%- endmacro %}

{% macro entry_rows(items, date_attr, state, due, links, flags, prefix, row_actions, description) %}
    {% for item in items %}
        {% set url = entry_url(item) if links else "" %}
        {% set title = item.display_title or item.title %}
        <tr>
            <td>
                {% if prefix %}{{ group_prefix(item.group_name) }}{% endif %}
                {%- if item.kind == "bookmark" %}{{ favicon(item) }}{% endif %}
                {%- if item.kind == "bookmark" %}
                    {% if url %}
                        <a href="{{ url }}">{{ title | e }}</a>
                    {% else %}
                        {{ title | e }}
                    {% endif %}
                {% elif url %}
                    <a href="{{ url }}">{{ title | markdown_inline(links=false) }}</a>
                {% else %}
                    {{ title | markdown_inline }}
                {% endif %}
                {%- if flags and item.archived %} <span class="status">(archived)</span>{% endif %}
                {%- if flags and item.pinned %} <span class="status">(pinned)</span>{% endif %}
                {% if item.kind == "bookmark" %}
                    <span class="table__sub">{{ bookmark_link(item) }}</span>
                    {% if item.snippet and not description %}<span class="table__sub">{{ item.snippet | markdown_inline }}</span>{% endif %}
                {% elif item.title and item.snippet %}
                    <span class="table__sub">{{ item.snippet | markdown_inline }}</span>
                {% endif %}
            </td>
            {% if description %}
                <td>
                    {% if item.snippet %}{{ item.snippet | markdown_inline }}{% endif %}
                </td>
            {% endif %}
            {% if state %}
                <td class="nowrap">
                    {% if item.state %}{{ state_label(item) }}{% endif %}
                </td>
            {% endif %}
            {% if due %}
                <td class="nowrap">
                    {% if item.deadline %}{{ when(item.deadline) }}{% endif %}
                </td>
            {% endif %}
            {% if date_attr %}<td class="nowrap">{{ when(item[date_attr]) }}</td>{% endif %}
            {% if row_actions %}<td class="table__actions">{{ row_actions(item) }}</td>{% endif %}
        </tr>
    {% endfor %}
{% endmacro %}

{% macro entry_table(items=None, sections=None, title_label="Title", date_label="Updated", date_attr="updated_at", state=False, due=False, links=True, flags=False, group_prefix=True, description=False) %}
    {% set row_actions = caller if caller else None %}
    {% set columns = 1 + (1 if description else 0) + (1 if state else 0) + (1 if due else 0) + (1 if date_attr else 0) + (1 if row_actions else 0) %}
    <div class="table-wrap">
        <table class="table entries">
            <thead>
                <tr>
                    <th>{{ title_label }}</th>
                    {% if description %}<th>Description</th>{% endif %}
                    {% if state %}<th>State</th>{% endif %}
                    {% if due %}<th>Due</th>{% endif %}
                    {% if date_attr %}<th>{{ date_label }}</th>{% endif %}
                    {% if row_actions %}
                        <th class="table__actions">
                            <span class="visually-hidden">Actions</span>
                        </th>
                    {% endif %}
                </tr>
            </thead>
            <tbody>
                {% if sections %}
                    {% for label, section_items in sections %}
                        <tr class="table__group">
                            <th colspan="{{ columns }}" scope="colgroup">
                                {{ label }} <span class="count">{{ "{:,}".format(section_items | length) }}</span>
                            </th>
                        </tr>
                        {{ entry_rows(section_items, date_attr, state, due, links, flags, group_prefix, row_actions, description) }}
                    {% endfor %}
                {% else %}
                    {{ entry_rows(items, date_attr, state, due, links, flags, group_prefix, row_actions, description) }}
                {% endif %}
            </tbody>
        </table>
    </div>
{% endmacro %}
