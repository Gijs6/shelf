{% extends "base.jinja" %}

{% from "partials/entries.jinja" import entry_table %}

{% block title %}Search{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Search</h1>
        <div class="page-head__actions">
            <button type="button"
                    class="btn"
                    data-search-help-toggle
                    aria-haspopup="dialog">Search syntax</button>
        </div>
    </div>

    <dialog id="search-help-modal" class="dialog" aria-labelledby="search-help-title">
        <div class="dialog__head">
            <h2 id="search-help-title">Search syntax</h2>
            <form method="dialog">
                <button type="submit" class="dialog__close" aria-label="Close">&times;</button>
            </form>
        </div>
        <div class="dialog__body">
                <h3>Type</h3>
                <table class="table table--kv">
                    <tbody>
                        <tr>
                            <th scope="row"><code>is:note</code> <code>is:todo</code> <code>is:sticky</code></th>
                            <td>Filter by item type. Multiple types can be combined.</td>
                        </tr>
                    </tbody>
                </table>
                <h3>Todo</h3>
                <table class="table table--kv">
                    <tbody>
                        <tr>
                            <th scope="row"><code>state:open</code> <code>state:active</code> <code>state:done</code> <code>state:cancelled</code> <code>state:shelved</code></th>
                            <td>Filter by todo status.</td>
                        </tr>
                        <tr>
                            <th scope="row"><code>overdue:yes</code> <code>overdue:no</code></th>
                            <td>Show todos that are overdue or not overdue.</td>
                        </tr>
                        <tr>
                            <th scope="row"><code>due:today</code> <code>due:week</code></th>
                            <td>Show todos due today or within the next 7 days.</td>
                        </tr>
                    </tbody>
                </table>
                <h3>Sticky notes</h3>
                <table class="table table--kv">
                    <tbody>
                        <tr>
                            <th scope="row"><code>pinned:yes</code> <code>pinned:no</code></th>
                            <td>Filter pinned sticky notes.</td>
                        </tr>
                        <tr>
                            <th scope="row"><code>colour:yellow</code> <code>colour:pink</code> <code>colour:blue</code> <code>colour:green</code> <code>colour:purple</code> <code>colour:orange</code></th>
                            <td>Filter by sticky note colour.</td>
                        </tr>
                    </tbody>
                </table>
                <h3>Groups and archive</h3>
                <table class="table table--kv">
                    <tbody>
                        <tr>
                            <th scope="row"><code>group:home</code></th>
                            <td>Match an exact group name.</td>
                        </tr>
                        <tr>
                            <th scope="row"><code>archived:yes</code> <code>archived:no</code></th>
                            <td>Include or exclude archived items.</td>
                        </tr>
                    </tbody>
                </table>
                <h3>Dates</h3>
                <table class="table table--kv">
                    <tbody>
                        <tr>
                            <th scope="row"><code>before:YYYY-MM-DD</code></th>
                            <td>Items created before this date.</td>
                        </tr>
                        <tr>
                            <th scope="row"><code>after:YYYY-MM-DD</code></th>
                            <td>Items created on or after this date.</td>
                        </tr>
                    </tbody>
                </table>
                <h3>Sorting</h3>
                <table class="table table--kv">
                    <tbody>
                        <tr>
                            <th scope="row"><code>sort:title</code> <code>sort:created</code> <code>sort:updated</code></th>
                            <td>Sort results. Default: last updated.</td>
                        </tr>
                    </tbody>
                </table>
        </div>
    </dialog>

    <search>
    <form method="get"
          class="input-row"
          hx-get="{{ url_for('search.search_view') }}"
          hx-trigger="input changed from:find input, submit"
          hx-select="#search-results"
          hx-target="#search-results"
          hx-swap="outerHTML"
          hx-replace-url="true">
        <label for="q" class="visually-hidden">Search</label>
        <input type="search"
               id="q"
               name="q"
               placeholder="is:todo state:open group:home overdue:yes due:week sort:title ..."
               value="{{ query }}"
               autocomplete="off"
               autofocus />
        <button type="submit" class="btn">Search</button>
    </form>
    </search>

    <section id="search-results" class="panel" aria-label="Search results">
        {% if results %}
            <h2 class="panel__heading">Results ({{ results | length }})</h2>
            {{ entry_table(results, kind=True, state=True, group=True, due=True) }}
        {% else %}
            <div class="empty">
                <p class="empty__title">No results</p>
                {% if query %}<p>No item matches "{{ query }}".</p>{% endif %}
            </div>
        {% endif %}
    </section>
{% endblock %}
