#!/bin/bash
FORMAT_HTML=1

setup() {
  i:venv
  i:npm_install
  i:vendor htmx.org/dist/htmx.min.js
  i:vendor easymde/dist/easymde.min.js
  i:vendor easymde/dist/easymde.min.css
}

serve() {
  i:serve_flask
}

seed() {
  .venv/bin/python seed.py "$@"
}

build() {
  i:build_css
}

deploy() {
  build
  echo "$(date +%Y.%m):$(git rev-parse --short HEAD):$(git rev-list --count HEAD)" > VERSION
  g:deploy
}
